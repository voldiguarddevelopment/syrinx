# Syrinx — one-run test config. Copy to `scripts/test-all.env` and fill in the
# paths to the weights + parity fixtures on THIS machine (the model box).
#
#   cp scripts/test-all.env.example scripts/test-all.env
#   $EDITOR scripts/test-all.env
#   ./scripts/test-all.sh
#
# Any group whose vars are left unset is SKIPPED (its tests self-skip), so you can
# fill in only what you have and the runner reports the rest as SKIP, never FAIL.
# A path that is set but does not exist also SKIPs — the tests check existence, not
# just presence — so the placeholder paths below are safe to leave in place.
# Paths below are the conventional box layout — adjust to yours.
#
# Every variable the suite reads is listed here. Required ones are `export`ed;
# optional knobs and tuning overrides are commented out with their defaults.
# `./scripts/test-all.sh --list` shows the groups these variables gate, plus the
# opt-in tests that belong to no group and must be named with `--test`.

# ============================ CosyVoice2 (CV2) ==============================
# DEPRECATED (see CLAUDE.md, "Model direction — Fish only"). The CV2/CV3 ports keep
# their code and their parity results but get no new work, and on a live box these
# are deliberately left UNSET so the cv2/cv2e2e/cv3/cv3e2e groups report SKIP. Do not
# point them at weights to "fix" a SKIP — the SKIP is the intended state.
export SYRINX_LM_WEIGHTS=/root/models/CosyVoice2-0.5B/llm_fp32.safetensors
export SYRINX_LM_REF=/root/parity/lm/ref.safetensors
export SYRINX_LMGEN_REF=/root/parity/lmgen/ref.safetensors
export SYRINX_FLOW_WEIGHTS=/root/models/CosyVoice2-0.5B/flow_fp32.safetensors
export SYRINX_FLOW_REF=/root/parity/flow/ref.safetensors
export SYRINX_HIFT_WEIGHTS=/root/models/CosyVoice2-0.5B/hift_fp32.safetensors
export SYRINX_HIFT_REF=/root/parity/hift/ref.safetensors
export SYRINX_SPK_WEIGHTS=/root/models/CosyVoice2-0.5B/campplus_fp32.safetensors
export SYRINX_SPK_REF=/root/parity/spk/ref.safetensors
export SYRINX_TOK_JSON=/root/models/CosyVoice2-0.5B/tokenizer.json
export SYRINX_TOK_REF=/root/parity/tok/ref.safetensors
export SYRINX_STOK_ONNX=/root/models/CosyVoice2-0.5B/speech_tokenizer_v2.onnx
export SYRINX_STOK_REF=/root/parity/stok/ref.safetensors
export SYRINX_FEAT_REF=/root/parity/feat/ref.safetensors
export SYRINX_TEXTNORM_REF=/root/parity/textnorm/ref.safetensors
export SYRINX_E2E_REF=/root/parity/e2e/ref.safetensors
export SYRINX_QUANT=1                       # int4 footprint A/B
export SYRINX_EVAL_REF_WAV=/root/refs/voice_zh.wav
export SYRINX_EVAL_REF_WAV_EN=/root/refs/voice_en.wav
export SYRINX_EVAL_PROMPT_TEXT_EN="the reference transcript in english"
# Optional CV2 knobs (defaults in the tests):
# export SYRINX_LMGEN_MAXSTEPS=…            # cap AR steps in real_lm_gen_parity/kvcache
# export SYRINX_LMGEN_SPEEDSTEPS=…          # steps for the KV-cache speedup measurement
# export SYRINX_SYNTH_MAXSTEPS=…            # cap AR steps in the e2e/eval tests
# export SYRINX_SYNTH_OUT=/tmp/synth.wav    # write the e2e render to disk
# export SYRINX_LM_HAMMER=1                 # enable the long LM soak (real_lm_hammer)
# export SYRINX_LM_HAMMER_PASSES=…          # soak passes (default in the test)
# export SYRINX_QUALITY_SOURCE=1            # real_eval_metrics: random-phase NSF source A/B
# export SYRINX_INSTRUCT="…"                # real_eval_metrics: score the emotion/instruct path

# ============================ CosyVoice3 (CV3) ==============================
# DEPRECATED — same rule as CV2 above: leave unset on a live box.
export SYRINX_CV3_LM_WEIGHTS=/root/models/Fun-CosyVoice3-0.5B-2512/llm_fp32.safetensors
export SYRINX_CV3_LM_REF=/root/parity-cv3/lm/ref.safetensors
export SYRINX_CV3_FLOW_WEIGHTS=/root/models/Fun-CosyVoice3-0.5B-2512/flow_fp32.safetensors
export SYRINX_CV3_FLOW_REF=/root/parity-cv3/flow/ref.safetensors
export SYRINX_CV3_HIFT_WEIGHTS=/root/models/Fun-CosyVoice3-0.5B-2512/hift_fp32.safetensors
export SYRINX_CV3_HIFT_REF=/root/parity-cv3/hift/ref.safetensors
export SYRINX_CV3_SPK_WEIGHTS=/root/models/Fun-CosyVoice3-0.5B-2512/campplus_fp32.safetensors
export SYRINX_CV3_TOK_JSON=/root/models/Fun-CosyVoice3-0.5B-2512/tokenizer.json
export SYRINX_CV3_STOK_ONNX=/root/models/Fun-CosyVoice3-0.5B-2512/speech_tokenizer_v3.onnx
export SYRINX_CV3_STOK_REF=/root/parity-cv3/stok/ref.safetensors
export SYRINX_CV3_E2E_REF=/root/parity-cv3/e2e/ref.safetensors
export SYRINX_CV3_QUANT=1
# Optional CV3 knobs:
# export SYRINX_CV3_TEXT="…"                # text for the CV3 eval-metrics render
# export SYRINX_CV3_PROMPT_TEXT="…"         # transcript of SYRINX_EVAL_REF_WAV
# export SYRINX_CV3_SYNTH_MAXSTEPS=…        # cap AR steps in the CV3 e2e tests
# export SYRINX_CV3_SYNTH_OUT=/tmp/cv3.wav  # write the CV3 e2e render to disk
# export SYRINX_CV3_QUALITY=1               # CV3 eval: random-phase NSF source A/B
# export SYRINX_CV3_INSTRUCT="…"            # CV3 eval: score the emotion/instruct path
# export SYRINX_CV3_PIN_REF=…               # CV3 eval diagnostic: pin the reference tokens
# export SYRINX_CV3_PIN_Z=…                 # CV3 eval diagnostic: pin the flow latent
# export SYRINX_CV3_GEN_DEBUG=1             # CV3 generation debug tracing

# ============================ Fish Audio (s1-mini / s2-pro) =================
# The active TTS path. Weights via:  ./scripts/test-all.sh --download-fish
# s1-mini (0.5B, gated — needs `hf auth login`):
export SYRINX_FISH_S1_DIR=/root/models/openaudio-s1-mini
# Parity dump for s1 — produced by:  scripts/gen-fish-ref.py --variant s1-mini …
export SYRINX_FISH_S1_REF=/root/parity-fish/s1/ref.safetensors
# s2-pro (5B, public). It loads in **bf16** on CUDA (f32 on CPU for parity) — there is
# no int4 path for s2, and no env knob turns one on. Resident weights are 9.49 GB:
# 9.12 GB LM (bf16 on disk, bf16 in VRAM) + 0.37 GB decode-side codec; the 0.42 GB
# encode-side codec is loaded only while a reference clip is being encoded. That fits a
# 12 GB card with ~1.4 GB of working headroom; long utterances are bounded by the codec
# synthesis chunk (SYRINX_FISH_CODEC_CHUNK_FRAMES), not by the weights.
export SYRINX_FISH_S2_DIR=/root/models/s2-pro
# Parity dump for s2 — produced by:  scripts/gen-fish-ref.py …  (needs the reference
# package at ~/refs/fish-speech + its uv venv; ~19 GB CPU/f32, run under run-isolated.sh).
# Leave it unset until the dump exists so the s2 parity test SKIPs honestly.
export SYRINX_FISH_S2_REF=/root/parity-fish/s2/ref.safetensors
# Zero-shot clone reference clip — required by real_fish_s{1,2}_e2e and, with the
# knobs further down, by the opt-in real_cue_activation gate. Any clean mono clip.
export SYRINX_FISH_REF_WAV=/root/refs/voice_en.wav
# Transcript of that clip; improves the clone and is read by run-fish.sh + cue activation.
export SYRINX_FISH_REF_TEXT="the reference transcript of the clone clip"
# CUDA ordinal for the Fish model (only honoured by a `--features cuda` build).
export SYRINX_FISH_DEVICE=0
# Optional Fish knobs (crate-side; unset = the crate's own default):
# export SYRINX_FISH_MAXFRAMES=…            # cap generated frames per render (e2e speed)
# export SYRINX_FISH_CKPT=…                 # checkpoint dir override for scripts/run-fish.sh
# export SYRINX_FISH_CODEC_CHUNK_FRAMES=…   # codec synthesis chunk (VRAM/latency tradeoff)
# export SYRINX_FISH_CODEC_ENCODE_CHUNK=…   # codec encode chunk for reference clips
# export SYRINX_FISH_CODEC_ROUNDTRIP=1      # encode->decode roundtrip debug path
# export SYRINX_FISH_DMMV=1                 # dequant-matmul-vector kernel path toggle
# export SYRINX_FISH_DUMP=…                 # dump intermediate tensors to this dir
# export SYRINX_FISH_MEM_REPORT=1           # print resident-weight accounting
# export SYRINX_FISH_REF_PY=…               # reference fish-speech checkout (gen-fish-ref.py)

# ============================ Qwen3-TTS (syrinx-qwen) =======================
# Gates GROUP_qwen_ckpt (the weight-backed half; GROUP_qwen is model-free and needs
# nothing here). Every fixture below is a .safetensors dump produced by one generator
# script, each of which drives the REFERENCE package's own modules — they need a python
# that can `import qwen_tts`  (uv venv --python 3.12 ~/.venvs/qwen && pip install qwen-tts).
#
# CustomVoice checkpoint — real_qwen_prompt_parity, real_qwen_stack_parity, and the
# opt-in real_qwen_greedy_parity all load it.
export SYRINX_QWEN_CV_DIR=/root/models/Qwen3-TTS-12Hz-1.7B-CustomVoice
# Prompt/talker/predictor/codec anchors — scripts/gen-qwen-ref.py --ckpt $SYRINX_QWEN_CV_DIR --out …
export SYRINX_QWEN_REF=/root/parity-qwen/1.7b-customvoice.safetensors
# Published Qwen3-TTS-Tokenizer-12Hz folder (the Mimi codec) — real_qwen_stack_parity
# and real_qwen_encode_parity.
export SYRINX_QWEN_TOK_DIR=/root/models/Qwen3-TTS-Tokenizer-12Hz
# `-Base` (voice-clone) checkpoint — real_qwen_speaker_parity.
export SYRINX_QWEN_BASE_DIR=/root/models/Qwen3-TTS-12Hz-1.7B-Base
# The reference clip fed to the two clone-side generators below (any sample rate).
export SYRINX_QWEN_REF_WAV=/root/refs/voice_en.wav
# Encode (waveform -> RVQ codes) anchor — scripts/gen-qwen-ref-encoder.py
#   --tok $SYRINX_QWEN_TOK_DIR --wav $SYRINX_QWEN_REF_WAV --out …
export SYRINX_QWEN_REF_ENCODE=/root/parity-qwen/encode.safetensors
# Speaker x-vector anchor — scripts/gen-qwen-ref-speaker.py
#   --ckpt $SYRINX_QWEN_BASE_DIR --wav $SYRINX_QWEN_REF_WAV --out …
export SYRINX_QWEN_REF_SPEAKER=/root/parity-qwen/speaker.safetensors
# The SECOND `-Base` checkpoint. The two sizes differ only in
# speaker_encoder_config.enc_dim (1024 on the 0.6B, 2048 on the 1.7B), which the port
# reads from config.json — so real_qwen_speaker_parity runs EVERY configured checkpoint,
# not the first one it finds. Dump it with the same generator:
#   scripts/gen-qwen-ref-speaker.py --ckpt …-0.6B-Base --wav $SYRINX_QWEN_REF_WAV --out …
# No second checkpoint-dir var is needed: the generator records the absolute --ckpt in the
# fixture's safetensors metadata and the test reads it from there. Set
# SYRINX_QWEN_BASE_DIR_0_6B only if the checkpoint has MOVED since the dump (the test then
# fails loudly rather than dropping that checkpoint silently).
export SYRINX_QWEN_REF_SPEAKER_0_6B=/root/parity-qwen/speaker-0.6b.safetensors
# export SYRINX_QWEN_BASE_DIR_0_6B=/root/models/Qwen3-TTS-12Hz-0.6B-Base
# Multi-frame greedy code matrix — scripts/gen-qwen-ref-greedy.py --ckpt $SYRINX_QWEN_CV_DIR --out …
# Consumed ONLY by the opt-in real_qwen_greedy_parity (~21 min; in no group — see below).
export SYRINX_QWEN_REF_GREEDY=/root/parity-qwen/greedy.safetensors
# CUDA ordinal for the Qwen tests (a `--features real` build without `cuda` falls back
# to CPU with a notice — CPU/f32 is the more faithful comparison against an f32 fixture).
export SYRINX_QWEN_DEVICE=0
# Optional Qwen knobs (read by crates/syrinx-qwen's own in-crate tests / examples):
# export SYRINX_QWEN_DIR=…                  # checkpoint for the text-tokenizer goldens
# export SYRINX_QWEN_TOKENIZER_DIR=…        # tokenizer dir for the in-crate Mimi parity test
# export SYRINX_QWEN_ENCODER_REF=…          # dir holding ref_meta.json for that same test
# export SYRINX_QWEN_EMBEDS=…               # examples/dump_prompt.rs writes talker embeds here
# export SYRINX_QWEN_CODEC_CHUNK_FRAMES=…   # codec decode chunk
# export SYRINX_QWEN_CODEC_PRE_CHUNK_FRAMES=…  # pre-decode chunk
# export SYRINX_QWEN_CODEC_ENCODE_CHUNK=…   # codec encode chunk

# ============================ speech-to-text (Whisper) =====================
# Pure-Rust/Candle Whisper (crates/syrinx-stt): the reverse path (audio->text) and
# the NATIVE TTS-intelligibility oracle (transcribe a synth output, score WER).
# Download a model (tiny/base/small/medium/large-v3):
#   hf download openai/whisper-base --local-dir /root/models/whisper-base
export SYRINX_STT_MODEL_DIR=/root/models/whisper-base
export SYRINX_STT_WAV=/root/refs/voice_en.wav
export SYRINX_STT_REF="the reference transcript of the test clip"
export SYRINX_STT_LANG=en                    # optional: force language (else auto)
export SYRINX_STT_WER_MAX=0.5                # optional: max acceptable WER

# ============================ opt-in gates (in NO group) ====================
# These tests belong to no group and no family, so no routine board and no full
# `verify.sh` runs them. Name them explicitly:
#
#   ./scripts/test-all.sh --test real_cue_activation        # C4.2 certification
#   ./scripts/test-all.sh --test real_qwen_greedy_parity    # ~21 min, needs the vars above
#
# real_cue_activation additionally needs SYRINX_FISH_S2_DIR, SYRINX_FISH_REF_WAV and
# SYRINX_STT_MODEL_DIR, and only runs at all when given an output path:
# export SYRINX_CUE_ACTIVATION_OUT=.opt-reports/cue-activation.json  # required to run it
# export SYRINX_CUE_ACTIVATION_N=4           # renders per condition (default 4, the minimum for α=0.05)
# export SYRINX_CUE_ACTIVATION_CASES=…       # cap the case count for a pilot run
# export SYRINX_CUE_ACTIVATION_ENFORCE=1     # turn the measured thresholds into assertions

# ============================ local CUDA toolkit (Blackwell) ===============
# Only needed for a `--features cuda` build on an RTX 50-series (sm_120) box: candle
# 0.8.4 pins cudarc 0.13.9, which rejects CUDA > 12.8, while Blackwell needs >= 12.8.
# `./scripts/setup-cuda-blackwell.sh` installs the local 12.8 + gcc 14 these point at.
# export CUDA_ROOT=$HOME/cuda-12.8
# export CUDA_PATH=$HOME/cuda-12.8
# export CUDA_TOOLKIT_ROOT_DIR=$HOME/cuda-12.8
# export PATH=$HOME/cuda-12.8/bin:$PATH
# export LD_LIBRARY_PATH=$HOME/cuda-12.8/lib64:${LD_LIBRARY_PATH:-}
# export NVCC_CCBIN=$HOME/gcc14/bin/g++      # CUDA 12.8 rejects gcc > 14
# export CUDA_COMPUTE_CAP=120                # sm_120; pinned so headless builds still target it

# ============================ eval helpers (optional) ======================
# Leave unset to report WER/MOS as honest nulls instead of measuring them.
export SYRINX_WER_HELPER="micromamba run -n syrinx python scripts/eval_wer.py"
export SYRINX_MOS_HELPER="micromamba run -n syrinx python scripts/eval_mos.py"
# export SYRINX_WER_MODEL=small              # whisper model for scripts/eval_wer.py
# export SYRINX_WER_LANG=zh                  # language hint for scripts/eval_wer.py
# export SYRINX_MOS_REPO=tarepan/SpeechMOS:v1.2.0   # torch.hub repo for scripts/eval_mos.py
# export SYRINX_MOS_MODEL=utmos22_strong     # torch.hub entry for scripts/eval_mos.py
# export SYRINX_REF=…                        # default --ref clip for scripts/synth-samples.sh
